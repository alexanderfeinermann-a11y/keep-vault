<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately standalone. No reference to Keep Vault, no shared source, no
    shared build: the scanner needs a camera and Keep Vault must never be the
    process that has one, so the separation is a property of the projects
    rather than a promise in a comment.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QR-Scanner</AssemblyName>
    <RootNamespace>QrScanner</RootNamespace>
    <Product>QR-Scanner</Product>
    <AssemblyTitle>QR-Scanner</AssemblyTitle>
    <!-- Generated by tools\New-QrScannerIcon.ps1 rather than committed as a binary. -->
    <ApplicationIcon Condition="Exists('Assets\QR-Scanner.ico')">Assets\QR-Scanner.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sources\CodeArbiter.cs" />
    <Compile Include="Sources\Localization.cs" />
    <Compile Include="Sources\MainWindow.cs" />
    <Compile Include="Sources\PayloadInspector.cs" />
    <Compile Include="Sources\Program.cs" />
    <Compile Include="Sources\ScanSession.cs" />
    <Compile Include="Sources\VolatileClipboard.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Windows has no barcode decoder a desktop application may call: the WinRT
      barcode API needs a point-of-sale scanner device, and the OCR engine does
      not read QR. The macOS scanner uses the system's own decoder (Vision);
      this one uses ZXing, the reference open-source implementation, pinned like
      every other dependency in this repository.
    -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QrScanner.Tests" />
  </ItemGroup>

</Project>
