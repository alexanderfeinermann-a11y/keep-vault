<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KalynaArchiver.MainWindow"
        x:Name="RootWindow"
        Title="Keep Vault"
        Width="1220"
        Height="860"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#08101D"
        ExtendClientAreaToDecorationsHint="False"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.Drop="Window_Drop"
        PointerMoved="Window_PointerMoved"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF6" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A3B8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#43D8E5" />
      <Setter Property="Foreground" Value="#04121B" />
      <Setter Property="Background" Value="#5DE4EC" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#81EEF3" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#17263A" />
      <Setter Property="BorderBrush" Value="#31445D" />
      <Setter Property="Foreground" Value="#E8EEF6" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22354D" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#54202A" />
      <Setter Property="BorderBrush" Value="#B8505E" />
      <Setter Property="Foreground" Value="#FFE8EB" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6B2633" />
    </Style>
    <Style Selector="Button.keySheet">
      <Setter Property="Background" Value="#B7F7DE" />
      <Setter Property="BorderBrush" Value="#78D9B4" />
      <Setter Property="Foreground" Value="#092A20" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#0A1423" />
      <Setter Property="Foreground" Value="#F3F7FB" />
      <Setter Property="BorderBrush" Value="#304259" />
      <Setter Property="SelectionBrush" Value="#287C8A" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#0A1423" />
      <Setter Property="BorderBrush" Value="#304259" />
      <Setter Property="Foreground" Value="#F3F7FB" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E8EEF6" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#07101D" />
      <Setter Property="BorderBrush" Value="#304259" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#101B2B" />
      <Setter Property="BorderBrush" Value="#24364C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.innerCard">
      <Setter Property="Background" Value="#091321" />
      <Setter Property="BorderBrush" Value="#2B3D54" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </Window.Styles>

  <Grid Margin="22" RowDefinitions="Auto,*,180">
    <Border Grid.Row="0" Classes="card" Padding="22,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="13" Height="30" CornerRadius="7" Background="#5DE4EC" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="Keep Vault" FontSize="30" FontWeight="Bold" />
          </StackPanel>
          <TextBlock x:Name="SubtitleText"
                     Text="Sichere, wiederherstellbare Archive für macOS"
                     Classes="muted"
                     Margin="24,0,0,0" />
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,210" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
          <TextBlock x:Name="LanguageLabel" Text="Sprache" Classes="muted" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged">
            <ComboBoxItem Content="Deutsch" Tag="de" />
            <ComboBoxItem Content="English" Tag="en" />
          </ComboBox>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Ellipse x:Name="IntegrityDot" Width="9" Height="9" Fill="#F2BD55" VerticalAlignment="Center" />
            <TextBlock x:Name="IntegrityText" Text="Integrität wird geprüft …" Foreground="#F2BD55" />
          </StackPanel>
          <TextBlock x:Name="CaptureText"
                     Grid.Row="2" Grid.ColumnSpan="2"
                     Text="Aufnahmeschutz: bestmöglich"
                     Classes="muted"
                     HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,14" Background="Transparent">
      <TabItem x:Name="ArchiveTab" Header="Archivierung">
        <Border x:Name="CreatePanel"
                Classes="card"
                Margin="0,10,0,0"
                Padding="18"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="CreatePanel_DragOver"
                DragDrop.Drop="CreatePanel_Drop">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="1.02*,18,0.98*">
              <StackPanel Grid.Column="0" Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="CreateTitleText" Text="Archiv erstellen" Classes="sectionTitle" />
                  <TextBlock x:Name="CreateSubtitleText"
                             Text="Dateien oder Ordner auswählen und ein neues Zielarchiv festlegen."
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="AddFilesButton" Content="Dateien hinzufügen" Click="AddFiles_Click" />
                  <Button x:Name="AddFolderButton" Content="Ordner hinzufügen" Click="AddFolder_Click" />
                  <Button x:Name="ClearInputsButton" Content="Auswahl leeren" Classes="secondary" Click="ClearInputs_Click" />
                </WrapPanel>
                <ListBox x:Name="InputList"
                         Height="190"
                         SelectionMode="Multiple"
                         DragDrop.AllowDrop="True"
                         DragDrop.DragOver="InputList_DragOver"
                         DragDrop.Drop="InputList_Drop" />
                <TextBlock x:Name="InputDropHintText"
                           Text="Dateien und Ordner hier ablegen."
                           Foreground="#5DE4EC" TextWrapping="Wrap" />

                <StackPanel Spacing="6">
                  <TextBlock x:Name="TargetArchiveLabel" Text="Zielarchiv" Classes="label" Margin="0" />
                  <TextBlock x:Name="TargetArchiveDropHintText"
                             Text="Ein Ordner erzeugt archive(1).kzpaq, eine Datei name(1).kzpaq."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ArchivePathBox"
                             PlaceholderText="/Pfad/zu/archiv(1).kzpaq"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="ArchivePathBox_DragOver"
                             DragDrop.Drop="ArchivePathBox_Drop"
                             TextChanged="ArchivePathBox_TextChanged" />
                    <Button x:Name="BrowseArchiveButton" Grid.Column="1" Content="Auswählen" Click="ChooseArchive_Click" />
                  </Grid>
                </StackPanel>

                <Border Classes="innerCard" Padding="13">
                  <Grid ColumnDefinitions="Auto,100,18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                    <TextBlock x:Name="CompressionLabel" Text="Kompression" VerticalAlignment="Center" />
                    <ComboBox x:Name="CompressionBox" Grid.Column="1" Margin="9,0,0,0" SelectedIndex="1" SelectionChanged="CompressionBox_SelectionChanged">
                      <ComboBoxItem Content="0" />
                      <ComboBoxItem Content="1" />
                      <ComboBoxItem Content="2" />
                      <ComboBoxItem Content="3" />
                      <ComboBoxItem Content="4" />
                      <ComboBoxItem Content="5" />
                    </ComboBox>
                    <CheckBox x:Name="EncryptBox" Grid.Column="3" Content="Archiv verschlüsseln" IsChecked="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="CipherSuiteLabel" Grid.Row="1" Text="Verfahren" VerticalAlignment="Center" />
                    <ComboBox x:Name="CipherSuiteBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="9,0,0,0" SelectedIndex="0" SelectionChanged="CipherSuiteBox_SelectionChanged">
                      <ComboBoxItem Content="Threefish 1024" Tag="Threefish1024" />
                      <ComboBoxItem Content="Kalyna 512/512" Tag="Kalyna512_512" />
                    </ComboBox>
                    <TextBlock x:Name="Argon2ProfileText"
                               Grid.Row="2" Grid.ColumnSpan="4"
                               Text="Argon2id: 1 GiB, 4 Iterationen, Parallelität 4, gesperrter RAM erforderlich"
                               Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Button x:Name="CreateArchiveButton" Content="Archiv speichern" HorizontalAlignment="Left" Click="CreateArchive_Click" />
              </StackPanel>

              <Border x:Name="CreatePasswordPanel" Grid.Column="2" Classes="innerCard" Padding="15">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="CreatePasswordSetupTitle" Text="Dreiteiliges Passwort" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="CreatePasswordSetupHelpText"
                             Text="Zum Entpacken werden Userpasswort, Faktor A und Faktor B benötigt."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />

                  <TextBlock x:Name="CreatePasswordLabel" Text="Userpasswort" Classes="label" Margin="0" />
                  <TextBox x:Name="CreatePasswordBox" MaxLength="128" PasswordChar="●" TextChanged="CreatePasswordBox_TextChanged" />
                  <TextBlock x:Name="CreatePasswordConfirmLabel" Text="Userpasswort wiederholen" Classes="label" Margin="0" />
                  <TextBox x:Name="CreatePasswordConfirmBox" MaxLength="128" PasswordChar="●" TextChanged="CreatePasswordBox_TextChanged" />
                  <TextBlock x:Name="PasswordHelpText"
                             Text="24 bis 128 Zeichen und mindestens 128 Bit konservative Bewertung."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock x:Name="PasswordEntropyStatusText" Text="Konservative Entropie: 0 / 128 Bit" Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock x:Name="PasswordPolicyStatusText" Text="Passwortanforderungen noch nicht erfüllt." Foreground="#F29AA6" FontSize="12" TextWrapping="Wrap" />

                  <Border Classes="card" Padding="13">
                    <StackPanel Spacing="8">
                      <TextBlock x:Name="PasswordGeneratorTitle" Text="Zwei unabhängige 512-Bit-Faktoren" FontWeight="SemiBold" />
                      <TextBlock x:Name="PasswordGeneratorHelpText"
                                 Text="Fünf getrennte Entropiepools benötigen je 512 Maus-Samples."
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <ProgressBar x:Name="EntropyProgress" Minimum="0" Maximum="512" Height="7" Foreground="#5DE4EC" />
                      <TextBlock x:Name="EntropyStatusText" Text="Entropie wird gesammelt …" Foreground="#5DE4EC" FontSize="12" TextWrapping="Wrap" />
                      <Button x:Name="GeneratePasswordButton" Content="Generieren" HorizontalAlignment="Left" Click="GeneratePassword_Click" />
                      <TextBlock x:Name="GeneratedPasswordFirstLabel" Text="Faktor A" Classes="label" Margin="0" />
                      <TextBox x:Name="GeneratedPasswordFirstBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Menlo" FontSize="11" MinHeight="55" />
                      <TextBlock x:Name="GeneratedPasswordSecondLabel" Text="Faktor B" Classes="label" Margin="0" />
                      <TextBox x:Name="GeneratedPasswordSecondBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Menlo" FontSize="11" MinHeight="55" />
                      <WrapPanel ItemSpacing="7" LineSpacing="7">
                        <Button x:Name="PrintKeySheetButton" Content="Getrennt drucken" Classes="keySheet" Click="PrintKeySheet_Click" />
                        <Button x:Name="SaveKeySheetButton" Content="Test-PDF" Classes="secondary" Click="SaveKeySheet_Click" />
                        <Button x:Name="ClearCreateSecretsButton" Content="Geheimwerte leeren" Classes="secondary" Click="ClearCreateSecrets_Click" />
                      </WrapPanel>
                      <TextBlock x:Name="KeySheetStatusText" Text="Schlüsselzettel noch nicht behandelt." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <TextBlock x:Name="HintLabel" Text="Optionaler Hinweis" Classes="label" Margin="0" />
                  <TextBox x:Name="HintBox" MaxLength="180" />
                  <TextBlock x:Name="HintWarningText"
                             Text="Öffentlicher Containerkopf: keine Geheimwerte eingeben."
                             Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem x:Name="ExtractTab" Header="Entpacken">
        <Border x:Name="ExtractPanel"
                Classes="card"
                Margin="0,10,0,0"
                Padding="18"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="ExtractPanel_DragOver"
                DragDrop.Drop="ExtractPanel_Drop">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="1.05*,18,0.95*">
              <StackPanel Grid.Column="0" Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="ExtractTitleText" Text="Archiv entpacken" Classes="sectionTitle" />
                  <TextBlock x:Name="ExtractSubtitleText" Text="ZPAQ oder verschlüsselten Container auswählen." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="innerCard" Padding="12">
                  <TextBlock x:Name="RecoveryPolicyText"
                             Text="KPAR2 prüft verschlüsselte Archive mit zwei MACs. Notfallwiederherstellung schreibt immer eine neue Datei."
                             Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <StackPanel Spacing="6">
                  <TextBlock x:Name="ArchiveFileLabel" Text="Archivdatei" Classes="label" Margin="0" />
                  <TextBlock x:Name="ExtractArchiveDropHintText" Text=".zpaq oder .kzpaq hier ablegen." Classes="muted" FontSize="12" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ExtractArchiveBox"
                             PlaceholderText="/Pfad/zum/Archiv.kzpaq"
                             TextChanged="ExtractArchiveBox_TextChanged"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="ExtractArchiveBox_DragOver"
                             DragDrop.Drop="ExtractArchiveBox_Drop" />
                    <Button x:Name="BrowseExtractArchiveButton" Grid.Column="1" Content="Auswählen" Click="ChooseExtractArchive_Click" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock x:Name="OutputFolderLabel" Text="Zielordner" Classes="label" Margin="0" />
                  <TextBlock x:Name="OutputFolderDropHintText" Text="Wird aus dem Archivnamen vorgeschlagen." Classes="muted" FontSize="12" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="OutputFolderBox"
                             PlaceholderText="/Pfad/zum/neuen/Zielordner"
                             TextChanged="OutputFolderBox_TextChanged"
                             DragDrop.AllowDrop="True"
                             DragDrop.DragOver="OutputFolderBox_DragOver"
                             DragDrop.Drop="OutputFolderBox_Drop" />
                    <Button x:Name="BrowseOutputFolderButton" Grid.Column="1" Content="Auswählen" Click="ChooseOutputFolder_Click" />
                  </Grid>
                </StackPanel>
                <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,8,0,0">
                  <Button x:Name="ExtractArchiveButton" Content="Entpacken" Click="ExtractArchive_Click" />
                  <Button x:Name="ListArchiveButton" Content="Inhalt anzeigen" Classes="secondary" Click="ListArchive_Click" />
                  <Button x:Name="EmergencyRecoveryButton" Content="Notfallwiederherstellung" Classes="danger" Click="EmergencyRecovery_Click" />
                  <Button x:Name="ClearExtractSecretsButton" Content="Geheimwerte leeren" Classes="secondary" Click="ClearExtractSecrets_Click" />
                </WrapPanel>
              </StackPanel>

              <Border Grid.Column="2" Classes="innerCard" Padding="15">
                <StackPanel Spacing="10">
                  <TextBlock x:Name="ExtractPasswordTitle" Text="Drei Faktoren zum Entpacken" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="ExtractPasswordHelpText"
                             Text="Userpasswort und beide Faktoren von den getrennten Schlüsselzetteln eingeben."
                             Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock x:Name="ExtractHintLabel" Text="Öffentlicher Hinweis" Classes="label" Margin="0" />
                  <Border Classes="card" Padding="11">
                    <TextBlock x:Name="ExtractHintText" Text="Noch kein Containerhinweis geladen." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock x:Name="ExtractPasswordLabel" Text="Userpasswort" Classes="label" Margin="0" />
                  <TextBox x:Name="ExtractPasswordBox" MaxLength="128" PasswordChar="●" />
                  <TextBlock x:Name="ExtractGeneratedPasswordFirstLabel" Text="Faktor A vom Schlüsselzettel" Classes="label" Margin="0" />
                  <TextBox x:Name="ExtractGeneratedPasswordFirstBox" MaxLength="160" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Menlo" MinHeight="62" />
                  <Button x:Name="ScanFirstFactorButton" Content="Faktor A per Kamera scannen" Classes="secondary" HorizontalAlignment="Left" Click="ScanFirstFactor_Click" />
                  <TextBlock x:Name="ExtractGeneratedPasswordSecondLabel" Text="Faktor B vom Schlüsselzettel" Classes="label" Margin="0" />
                  <TextBox x:Name="ExtractGeneratedPasswordSecondBox" MaxLength="160" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Menlo" MinHeight="62" />
                  <Button x:Name="ScanSecondFactorButton" Content="Faktor B per Kamera scannen" Classes="secondary" HorizontalAlignment="Left" Click="ScanSecondFactor_Click" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem x:Name="EraseTab" Header="Kryptografisch löschen">
        <Border x:Name="ErasePanel"
                Classes="card"
                Margin="0,10,0,0"
                Padding="18"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="ErasePanel_DragOver"
                DragDrop.Drop="ErasePanel_Drop">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="830" Spacing="13">
              <StackPanel Spacing="4">
                <TextBlock x:Name="EraseTitleText" Text="Kryptografisch löschen" Classes="sectionTitle" />
                <TextBlock x:Name="EraseSubtitleText"
                           Text="Wiederherstellungsdaten zuerst vernichten, danach den verschlüsselten Container beschädigen und löschen."
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="EraseFileLabel" Text="Verschlüsselter Container" Classes="label" Margin="0" />
              <TextBlock x:Name="EraseDropHintText" Text="Eine .kzpaq-Datei hier ablegen." Classes="muted" FontSize="12" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="ErasePathBox"
                         PlaceholderText="/Pfad/zum/Container.kzpaq"
                         TextChanged="ErasePathBox_TextChanged"
                         DragDrop.AllowDrop="True"
                         DragDrop.DragOver="ErasePathBox_DragOver"
                         DragDrop.Drop="ErasePathBox_Drop" />
                <Button x:Name="BrowseEraseButton" Grid.Column="1" Content="Auswählen" Click="ChooseEraseFile_Click" />
              </Grid>
              <Button x:Name="AnalyzeEraseButton" Content="Analysieren" HorizontalAlignment="Left" Click="AnalyzeErase_Click" />
              <Border Classes="innerCard" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock x:Name="EraseStatusText" Text="Noch keine Datei analysiert." Foreground="#F2BD55" TextWrapping="Wrap" />
                  <TextBlock x:Name="EraseHardwareNoticeText"
                             Text="Per-Datei-Hardwarelöschung ist auf SSDs und APFS nicht garantiert."
                             Foreground="#F29AA6" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <CheckBox x:Name="EraseConfirmBox"
                        Content="Ich verstehe die SSD- und APFS-Grenze und möchte diesen verschlüsselten Container löschen." />
              <Button x:Name="EraseContainerButton" Content="Container kryptografisch löschen" Classes="danger" HorizontalAlignment="Left" Click="EraseContainer_Click" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Classes="card" Background="#050B14" Padding="14">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="LogTitleText" Text="Sicherheitsprotokoll" FontWeight="SemiBold" />
            <TextBlock x:Name="OperationStatusText" Text="Start …" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="ClearLogButton" Grid.Column="1" Content="Leeren" Classes="secondary" Click="ClearLog_Click" />
        </Grid>
        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 Margin="0,9,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Menlo"
                 FontSize="11"
                 Background="Transparent"
                 BorderThickness="0" />
      </Grid>
    </Border>

    <Border x:Name="PrivacyShield"
            Grid.RowSpan="3"
            ZIndex="1000"
            IsVisible="False"
            Background="#0A1320"
            CornerRadius="16"
            BorderBrush="#304259"
            BorderThickness="1">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Border Width="64" Height="8" CornerRadius="4" Background="#5DE4EC" HorizontalAlignment="Center" />
        <TextBlock Text="Keep Vault" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="PrivacyShieldText"
                   Text="Geheimnisansicht verdeckt, solange Keep Vault nicht aktiv ist."
                   Classes="muted"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="480" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
