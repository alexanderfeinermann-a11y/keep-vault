<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Entitlements for the QR scanner helper.

    Camera access lives here and nowhere else. The core holds the archive keys
    and runs for as long as the app is open; letting it look through the camera
    for that whole time buys nothing and widens what a flaw in it could reach.
    This helper exists only for the seconds a scan takes and declares no other
    capability.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
