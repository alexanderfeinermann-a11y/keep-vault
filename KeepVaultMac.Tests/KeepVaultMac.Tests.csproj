<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>KeepVaultMac.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="MarsKnownAnswers.txt" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../KeepVaultMac/KeepVaultMac.csproj" />
    <Compile Include="../KalynaArchiver.Signing/Mldsa87Reference.cs" Link="Signing/Mldsa87Reference.cs" />
    <!-- Test-only windowing backend so the real MainWindow can be driven without
         a display. It is referenced by this harness alone and never reaches the
         signed app, whose package set stays pinned by its own lockfile hash. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
  </ItemGroup>
</Project>
